# 本地复制为 .env；部署环境直接注入。所有地址、密钥和密码均留空，不自动读取其他仓库配置。
APP_KEYS=
# 同时运行管理服务时建议本服务设置不同端口；默认 7001。
PORT=
CALCULATOR_READER_SITE=
CALCULATOR_READER_CHANNEL=
CALCULATOR_READER_REDIS_TIMEOUT_MS=
CALCULATOR_READER_MONGO_TIMEOUT_MS=
# URI 不含用户名密码；按实际认证库保留 authSource。
MONGO_URI=
MONGO_DB=
MONGO_USERNAME=
# 使用平台已经解密的实际密码；本模拟服务不引入 XDCM/SCC。
MONGO_PASSWORD=
# 留空时跳过 Redis 并回退 Mongo。每个部署只配置自己的站点实例。
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# 后台刷新默认启用；未配置 REDIS_HOST 时自动跳过。false 可关闭。
CALCULATOR_REFRESH_ENABLED=
# 检查间隔（毫秒），默认 60000，修改后重启生效。
CALCULATOR_REFRESH_INTERVAL_MS=
