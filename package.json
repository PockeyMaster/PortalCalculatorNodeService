{
  "name": "portal-calculator-node-service",
  "version": "1.0.0",
  "private": true,
  "description": "Egg 3 TypeScript service for Node.js 16",
  "engines": {
    "node": "16.x"
  },
  "egg": {
    "typescript": true
  },
  "scripts": {
    "dev": "egg-bin dev",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc",
    "start": "egg-scripts start --daemon --title=portal-calculator-node-service",
    "stop": "egg-scripts stop --title=portal-calculator-node-service",
    "test:unit": "mocha -r ts-node/register/transpile-only \"test/**/*.test.ts\"",
    "test": "npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "egg": "3.17.5",
    "egg-scripts": "2.17.0",
    "ioredis": "5.11.0",
    "mongodb": "5.9.2"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "16.18.126",
    "egg-bin": "5.13.0",
    "mocha": "10.8.2",
    "ts-node": "10.9.2",
    "typescript": "4.9.5"
  },
  "overrides": {
    "utility@^2.0.0": "2.1.0"
  }
}
